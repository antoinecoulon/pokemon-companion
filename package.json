{
  "name": "pokemon-companion",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "description": "Companion de suivi du post-game de Pok\u00e9mon Unbound",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "validate": "node scripts/validate-content.mjs",
    "scrape:wiki": "node scripts/scrape-wiki.mjs",
    "check": "nuxt prepare && pnpm validate && pnpm test:stats && pnpm test:roster && pnpm test:fiche && pnpm test:sync && pnpm test:migration && pnpm typecheck",
    "smoke": "node scripts/smoke.mjs",
    "icons": "node scripts/make-icons.mjs",
    "sprites": "node scripts/fetch-sprites.mjs",
    "new:pokemon": "node scripts/new-content.mjs pokemon",
    "new:npc": "node scripts/new-content.mjs npc",
    "new:task": "node scripts/new-content.mjs task",
    "new:goal": "node scripts/new-content.mjs goal",
    "import:pokemon": "node scripts/import-pokemon.mjs",
    "rm:pokemon": "node scripts/rm-pokemon.mjs",
    "test:stats": "node scripts/test-stats.mjs",
    "test:roster": "node scripts/test-roster.mjs",
    "test:fiche": "node scripts/test-fiche.mjs",
    "test:sync": "node scripts/test-sync.mjs",
    "test:migration": "node scripts/test-migration.mjs",
    "smoke:features": "node scripts/smoke-features.mjs",
    "smoke:offline": "node scripts/smoke-offline.mjs",
    "serve:pages": "node scripts/serve-static.mjs"
  },
  "dependencies": {
    "@nuxt/ui": "^4.10.0",
    "nuxt": "^4.5.1",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.120",
    "@types/node": "^26.1.2",
    "@vite-pwa/nuxt": "^1.1.1",
    "jiti": "^2.7.0",
    "playwright": "^1.62.0",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
